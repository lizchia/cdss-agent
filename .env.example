# Copy to .env for local development. Never commit .env.
# In ECS, these are injected from the task definition / Secrets Manager instead.

CDSS_APP_ENV=local
CDSS_LOG_LEVEL=INFO

# --- AWS / Bedrock ---------------------------------------------------------
# Credentials come from the default boto3 chain (AWS_PROFILE locally, IAM task role in ECS).
CDSS_AWS_REGION=us-east-1
# Use a current Claude model ID / inference profile enabled in your Bedrock console.
CDSS_BEDROCK_MODEL_ID=
CDSS_BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
CDSS_LLM_TEMPERATURE=0.0
CDSS_LLM_MAX_TOKENS=2048

# --- PostgreSQL ------------------------------------------------------------
CDSS_DB_HOST=localhost
CDSS_DB_PORT=5432
CDSS_DB_NAME=cdss
CDSS_DB_USER=cdss_app
CDSS_DB_PASSWORD=
# staging/prod require one of: require | verify-ca | verify-full
CDSS_DB_SSL_MODE=prefer
CDSS_DB_POOL_MIN_SIZE=1
CDSS_DB_POOL_MAX_SIZE=10
CDSS_DB_STATEMENT_TIMEOUT_MS=5000

# --- RAG / ML artifacts ----------------------------------------------------
CDSS_FAISS_INDEX_DIR=data/faiss_index
CDSS_RAG_TOP_K=4
CDSS_RISK_MODEL_PATH=models/icu_los.pt

# --- Agent resilience ------------------------------------------------------
CDSS_TOOL_TIMEOUT_SECONDS=15
CDSS_MAX_TOOL_RETRIES=2
